# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ringabell

# OAuth (nuxt-auth-utils) — add when implementing auth
# NUXT_OAUTH_GITHUB_CLIENT_ID=
# NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Email (Resend — NOT nodemailer, incompatible with Cloudflare Workers)
# RESEND_API_KEY=
